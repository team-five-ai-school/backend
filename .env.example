# Copy to .env. Never commit real values: this repo is public.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# CORS_ORIGINS=*     # comma-separated origins, e.g. https://team5-ai.vercel.app
# Signs user JWTs. REQUIRED in production (min 32 chars): openssl rand -base64 48
# Local dev falls back to an insecure built-in secret if unset.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d  # keep in sync with the frontend session cookie max-age (7 days)

# AI (Anthropic via the AI SDK). Without a key or a model id, AI steps use their deterministic fallback
# (onboarding never fails). Model ids are set per task, never hardcoded.
# ANTHROPIC_API_KEY=
# AI_MODEL_EXTRACTION=claude-haiku-5-5   # free text → work tasks
# AI_MODEL_RERANK=                       # later: plan reranking
# AI_MODEL_MENTOR=                       # later: lesson mentor
# AI_TIMEOUT_MS=15000                    # hard timeout per model call

# Tests: e2e runs only against this throwaway DB (it truncates tables). Never point it at a shared DB.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
