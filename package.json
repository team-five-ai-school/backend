{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "content:sync": "node scripts/sync-content.mjs",
    "db:seed": "node --env-file-if-exists=.env src/seed/index.ts",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "ai": "^7.0.179",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  }
}
